/target
**/*.elf
**/*.bin
**/*.bkp
__pycache__/
*.pyc
/packages/**/build/
/dock/build/
/dock/dist/
*.egg-info/

# Local reference & working directories (not tracked in public repository)
/.claude/
/inspo/
/docs/
/backups/
/tmp/
*.zip.html
/.agents/

# Release artifacts & private signing keys (only keys/trusted-keys.json public keys are tracked)
/dist/
keys/*.key.json
keys/*.private.json
keys/private/
*.lms-key.json
